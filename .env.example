# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.

# --- App ---
APP_URL=http://localhost:3000
# Secreto para firmar la cookie de empresa activa (32+ caracteres aleatorios)
SESSION_SECRET=

# --- Supabase (los valores locales salen de `supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor (adaptador AuthProvider para invitaciones y administración de usuarios)
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de datos ---
# Conexión de la app web con el rol app_user (RLS activo)
DATABASE_URL=postgresql://app_user:app_user_password@127.0.0.1:54322/postgres
# Conexión de migraciones y worker con el rol dueño (sin RLS)
DATABASE_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Correo ---
# En desarrollo puede quedar vacío: se usa el Mailer de consola / Inbucket local
RESEND_API_KEY=
MAIL_FROM="LinkUs <notificaciones@linkus.pe>"

# --- Jobs ---
REMINDER_HOURS=24

# --- Observabilidad ---
SENTRY_DSN=

# --- Seed (solo desarrollo y demo) ---
SEED_SUPERADMIN_EMAIL=
SEED_DEFAULT_PASSWORD=

# --- Solo para el MCP de Supabase en Claude Code (no los usa la app) ---
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
