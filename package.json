{
  "name": "modern-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/worker.ts",
    "lint": "next typegen && eslint . --max-warnings=0 --cache",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "supabase db reset && pnpm db:migrate",
    "db:seed": "node scripts/not-implemented.mjs db:seed \"E1 (planes) / E7 (demo)\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.8",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "pg-boss": "12.39.0",
    "pino": "10.4.0",
    "postgres": "4.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "resend": "6.39.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supabase": "3.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
