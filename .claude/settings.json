{
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(npx playwright:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(npx shadcn@latest add:*)",
      "Bash(supabase start)",
      "Bash(supabase stop)",
      "Bash(supabase status)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git rebase origin/develop)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh project list:*)",
      "Bash(gh project view:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project field-list:*)",
      "Bash(gh project item-edit:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(ls:*)",
      "Bash(cat package.json)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.*.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(supabase db reset --linked:*)",
      "Bash(supabase db push:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --set-upstream origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin develop:*)",
      "Bash(git push -u origin develop:*)",
      "Bash(git push --set-upstream origin develop:*)",
      "Bash(git push origin HEAD:develop:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/on-stop.mjs"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    }
  },
  "enabledPlugins": {
    "modern-web-guidance@googlechrome": true
  }
}
