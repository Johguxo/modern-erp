# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.
# `src/env.ts` valida estas variables al arrancar `pnpm dev`, `pnpm start` y `pnpm worker`:
# si falta una obligatoria, el proceso no arranca y dice cuál. Las marcadas (opcional) pueden quedar vacías.

# --- App ---
APP_URL=http://localhost:3000
# Secreto para firmar la cookie de empresa activa (32+ caracteres aleatorios). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Supabase ---
# Valores locales: `pnpm exec supabase status -o env` (ANON_KEY y SERVICE_ROLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor (adaptador AuthProvider para invitaciones y administración de usuarios)
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de datos ---
# Conexión de la app web con el rol app_user (RLS activo). La contraseña local la pone
# supabase/seed/local-roles.sql. En producción: pooler en modo transacción (puerto 6543,
# usuario app_user.<project_ref>). Ver ADR-004.
DATABASE_URL=postgresql://app_user:app_user_password@127.0.0.1:54322/postgres
# Conexión de migraciones y worker con el rol dueño (sin RLS). En producción: directa o modo sesión (5432).
DATABASE_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Correo ---
# (opcional) En desarrollo puede quedar vacío: se usa el Mailer de consola / Inbucket local
RESEND_API_KEY=
MAIL_FROM="LinkUs <notificaciones@linkus.pe>"

# --- Jobs ---
REMINDER_HOURS=24

# --- Observabilidad ---
# (opcional)
SENTRY_DSN=

# --- Seed (solo desarrollo y demo; las exige únicamente `pnpm db:seed`) ---
SEED_SUPERADMIN_EMAIL=
SEED_DEFAULT_PASSWORD=

# --- Solo para el MCP de Supabase en Claude Code (no los usa la app; expórtalas en tu terminal) ---
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
